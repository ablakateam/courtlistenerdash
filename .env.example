# Public address placed in the locally issued HTTPS certificate. For LAN use,
# set this to the server's LAN IP or resolvable local hostname before startup.
COURTLISTENER_SITE_ADDRESS=localhost

# Host port for the HTTPS dashboard. Change this if 8443 is already in use.
COURTLISTENER_HTTPS_PORT=8443

# Optional upstream overrides. The defaults use the official CourtListener MCP.
# COURTLISTENER_MCP_URL=https://mcp.courtlistener.com/
# COURTLISTENER_MCP_HEALTH_URL=https://mcp.courtlistener.com/health

# Optional Jev bootstrap. The recommended setup is to paste the key after
# sign-in under Settings → Jev Intelligence, where it is encrypted at rest.
# Use a mounted secret instead of plain text when the platform supports it.
# TYPESAFE_API_KEY_FILE=/run/secrets/typesafe_api_key
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# TYPESAFE_MODE=off
# TYPESAFE_REQUEST_TIMEOUT_MS=15000
