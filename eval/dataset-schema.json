{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawnova.pro/schemas/jev-legal-relevance-evaluation-v1.json",
  "title": "Attorney-reviewed Jev legal relevance row",
  "type": "object",
  "additionalProperties": false,
  "required": ["queryId", "candidateId", "label", "score", "baselineRank", "jevRank"],
  "properties": {
    "queryId": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "label": { "type": "integer", "minimum": 0, "maximum": 3 },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "baselineRank": { "type": "integer", "minimum": 1 },
    "jevRank": { "type": "integer", "minimum": 1 },
    "latencyMs": { "type": "number", "minimum": 0 },
    "estimatedCostUsd": { "type": "number", "minimum": 0 },
    "modelVersion": { "type": "string" },
    "schemaVersion": { "const": "search_relevance_noul_v1" }
  }
}
